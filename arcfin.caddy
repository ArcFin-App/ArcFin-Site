# ============================================================
# arcfin.psmattas.com
# Static site only — no backend, no proxy. Serves everything in
# site/arcfin.psmattas.com/ from this repo.
#
# The Deploy workflow syncs that folder to the root path below on
# every push to main. Caddy only needs reloading when this file
# changes.
# ============================================================

arcfin.psmattas.com {
    import hsts_headers

    root * /srv/sites/arcfin.psmattas.com
    file_server
}
