# ============================================================
# arcfin.psmattas.com
# Static site only — no backend, no proxy. Serves everything in
# site/arcfin.psmattas.com/ from this repo.
#
# The Deploy workflow syncs that folder to the root path below on
# every push to main and every hour. Caddy only needs reloading
# when this file changes.
# ============================================================

arcfin.psmattas.com {
    import hsts_headers

    root * /srv/sites/arcfin.psmattas.com
    encode zstd gzip

    # The only outside addresses are Cloudflare Web Analytics: its script
    # and the endpoint it reports to. script-src allows inline scripts only
    # because Cloudflare injects a per-request loader for its bot detection;
    # the site's own scripts are all files.
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        Cross-Origin-Opener-Policy "same-origin"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }

    # Apple fetches this so Arcfin can open the Apple TV's Quick Connect QR code. It has no
    # file extension, so Caddy wouldn't send it as JSON by itself.
    @aasa path /.well-known/apple-app-site-association
    header @aasa Content-Type application/json

    # The app README's version badge changes with every build, and nothing else sets a
    # cache time, so Cloudflare would keep it for its default four hours.
    @badges path /badges/*
    header @badges Cache-Control "public, max-age=300"

    # What the app downloads for Legal & Licenses (scripts/legal.py). Short, so a changed
    # policy reaches the app within minutes.
    @legal path /legal/*
    header @legal Cache-Control "public, max-age=300"

    file_server

    # Missing pages get the 404 page in the language of the folder they
    # were asked for in, with a real 404 status.
    handle_errors {
        @notfound expression {err.status_code} == 404
        handle @notfound {
            @translated path_regexp lang ^/(de|es|fr|it|nl|pt-br|ru|ja|ko|zh-hans)/
            rewrite @translated /{re.lang.1}/404/index.html
            rewrite * /404/index.html
            file_server {
                status 404
            }
        }
        respond "{err.status_code} {err.status_text}"
    }
}
